# Modèle de secrets pour DIGIPRINT Tarification.
# En local : copiez ce fichier en .streamlit/secrets.toml et remplacez les valeurs.
# Sur Streamlit Community Cloud : collez ce contenu dans Settings > Secrets.
# Sans section [neon], l'application utilise une base SQLite locale (data/digiprint.sqlite).

[neon]
# Chaîne de connexion copiée depuis la console Neon (bouton « Connect »).
# Les formats postgresql://… et postgresql+psycopg2://… sont acceptés.
url = "postgresql+psycopg2://UTILISATEUR:MOT_DE_PASSE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Facultatif : protège la page Paramètres par un mot de passe.
# Une seule des deux clés suffit ; l'empreinte évite de stocker le mot de passe en clair :
#   python -c "import hashlib; print(hashlib.sha256('mon-mot-de-passe'.encode()).hexdigest())"
[admin]
mot_de_passe = "change-moi"
# mot_de_passe_sha256 = "…"
